model UserBrokerProfile {
  id                        String    @id @default(uuid())
  userId                    String    @unique
  user                      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerType                String    @default("fbs")
  platform                  String    @default("mt5")
  accountLogin              String
  server                    String
  connectionMode            String    @default("read_only")
  status                    String    @default("pending")
  encryptedInvestorPassword String
  encryptedTradingPassword  String?
  balance                   Float     @default(0.0)
  equity                    Float     @default(0.0)
  margin                    Float     @default(0.0)
  freeMargin                Float     @default(0.0)
  leverage                  String    @default("1:500")
  currency                  String    @default("USD")
  lastSyncedAt              DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([userId])
}
